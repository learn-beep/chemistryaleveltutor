---
import Base from '../../layouts/Base.astro';
import { allQuestions, topicByslug } from '../../lib/data';
const prac = allQuestions.filter((q) => (q.features || []).includes('practical') && !q.notCurrentSpec);
const codes = {};
for (const q of prac) for (const s of q.skills || []) { if (!s.code.startsWith('RP')) continue; if (!codes[s.code]) codes[s.code] = { text: s.text, qs: [] }; codes[s.code].qs.push(q); }
const num = (c) => Number(c.slice(2));
const order = Object.keys(codes).sort((a, b) => num(a) - num(b));
const skillsOnly = prac.filter((q) => !(q.skills || []).some((s) => s.code.startsWith('RP')));
// The twelve required practicals as the specification names them, and what the written papers ask about each, in the site's words. To be checked by a tutor.
const how = {
  RP1: ['Make up a volumetric solution and carry out a simple acid–base titration', 'Weighing by difference, dissolving and making up to the mark in a volumetric flask, then titrating with a pipette and burette. Papers ask for concordant titres and the mean, the titration calculation, percentage uncertainty, rinsing errors and the choice of indicator.'],
  RP2: ['Measurement of an enthalpy change', 'Measuring a temperature change in a polystyrene cup or with a spirit burner and using q = mcΔT. Papers ask about heat loss, extrapolating a cooling curve back to the time of mixing, incomplete combustion and why the value differs from the data-book value.'],
  RP3: ['Investigation of how the rate of a reaction changes with temperature', 'Timing a reaction at several temperatures, for example sodium thiosulfate and acid until a cross disappears, with 1/t as a measure of rate. Papers ask about controlling the other variables, the shape of the graph and why the rate rises so steeply.'],
  RP4: ['Carry out simple test-tube reactions to identify cations and anions', 'Tests for Group 2 ions and ammonium ions, and for halide, hydroxide, carbonate and sulfate ions. Papers ask for the reagent, the observation and the ionic equation, and for a sequence of tests to tell several solutions apart.'],
  RP5: ['Distillation of a product from a reaction', 'Distilling a product off as it forms, for example an aldehyde from a primary alcohol or cyclohexene from cyclohexanol. Papers ask for a labelled diagram of the apparatus, anti-bumping granules, where the water enters the condenser, and how the product is separated and dried.'],
  RP6: ['Tests for alcohol, aldehyde, alkene and carboxylic acid', 'Acidified potassium dichromate(VI), Tollens’ reagent or Fehling’s solution, bromine water and sodium carbonate or hydrogencarbonate. Papers ask for the reagent and the observation with each compound, often to distinguish a pair.'],
  RP7: ['Measuring the rate of reaction by an initial rate method and by a continuous monitoring method', 'An initial rate method such as the iodine clock, and following a reaction continuously by gas volume, mass or colorimetry. Papers ask for orders from the data, the rate equation and the rate constant, and for a tangent to find a rate from a curve.'],
  RP8: ['Measuring the EMF of an electrochemical cell', 'Setting up two half-cells with a salt bridge and a high-resistance voltmeter. Papers ask about cleaning the electrodes, what the salt bridge is for and what it contains, standard conditions, and the conventional cell representation.'],
  RP9: ['Investigate how pH changes when a weak acid reacts with a strong base and when a strong acid reacts with a weak base', 'Calibrating a pH meter and recording pH as alkali or acid is added in small portions. Papers ask for the method, the shape of the curve, the equivalence point, the choice of indicator and how to find Ka from the half-neutralisation point.'],
  RP10: ['Preparation of a pure organic solid and test of its purity, and of a pure organic liquid', 'Heating under reflux, filtering under reduced pressure, recrystallising from the minimum volume of hot solvent and measuring a melting point, for example with aspirin; and purifying a liquid with a separating funnel, a drying agent and distillation. Papers ask for the reason for each step and for percentage yield.'],
  RP11: ['Carry out simple test-tube reactions to identify transition metal ions in aqueous solution', 'Adding sodium hydroxide, ammonia and sodium carbonate solutions to aqueous metal ions such as Fe²⁺, Cu²⁺, Fe³⁺ and Al³⁺. Papers ask for the colour of each solution and precipitate, whether it dissolves in excess, and the equations.'],
  RP12: ['Separation of species by thin-layer chromatography', 'Spotting a TLC plate, running it in a covered beaker with a little solvent, locating the spots with UV light or a developing agent such as ninhydrin, and calculating Rf values. Papers ask why the pencil line must be above the solvent, why the lid is on, and why substances travel different distances.'],
};
const ref = (q) => `${q.series.replace('June ', 'Jun ').replace('November ', 'Nov ')} ${q.level === 'AS' ? 'AS ' : ''}${q.paper.replace('Paper ', 'P')} Q${q.question}`;
---
<Base title="AQA A-level Chemistry required practicals 1 to 12: every exam question, with mark schemes" description="Every AQA Chemistry past-paper question on the twelve required practicals: titration, enthalpy change, rates, tests for ions, distillation, organic tests, electrochemical cells, pH curves, organic preparation, transition metal ions and thin-layer chromatography, plus the planning, uncertainty and evaluation questions." context="practicals" leadLine="Practical questions are at least 15% of the marks and the easiest to lose. A tutor can take you through each required practical.">
  <h1>Required practicals</h1>
  <p>At least 15% of the marks on the written papers are for practical skills, and Paper 3 carries 40 marks on practical techniques and data analysis. AQA sets twelve required practicals: 1 to 6 in the first year (and for AS), 7 to 12 in the second year. Below is what each involves, what the papers ask about it, and every past-paper question tagged to it. There are {prac.length} practical question parts in total; <a href="/questions/type/practical-questions/">see them all with their mark schemes</a>.</p>
  <h2>The twelve required practicals</h2>
  <div class="table-wrap"><table><thead><tr><th>No.</th><th>Required practical</th><th>What the papers ask</th><th>Questions</th></tr></thead>
  <tbody>{Object.keys(how).map((c) => <tr><td>{codes[c] ? <a href={`#${c}`}>{num(c)}</a> : num(c)}</td><td>{how[c][0]}</td><td>{how[c][1]}</td><td>{codes[c]?.qs.length || 0}</td></tr>)}</tbody></table></div>
  <p class="muted">The names are AQA's, from the practical assessment section of the specification. The descriptions were written by the site from the specification and the mark schemes and are being checked by our tutor. The Practical Endorsement itself is assessed by your teacher and reported separately as a pass.</p>
  {order.map((c) => <section id={c}><h2>Required practical {num(c)}: {how[c] ? how[c][0] : codes[c].text}</h2><p class="muted">{how[c] ? how[c][1] : ''}</p>
    <ul class="qlinks">{codes[c].qs.sort((a, b) => b.year - a.year).map((q) => <li><a href={`/questions/${q.topics[0]}/#${q.id}`}>{ref(q)}</a> <span class="muted">{q.marks} mark{q.marks === 1 ? '' : 's'} · {topicByslug.get(q.topics[0])?.name}</span></li>)}</ul></section>)}
  <section id="skills"><h2>Other practical questions</h2><p class="muted">Questions on apparatus and techniques, experimental design, variables, anomalies, uncertainties and improvements that are not tied to one required practical.</p>
    <details class="spec-fold"><summary>{skillsOnly.length} questions</summary><ul class="qlinks">{skillsOnly.sort((a, b) => b.year - a.year).map((q) => <li><a href={`/questions/${q.topics[0]}/#${q.id}`}>{ref(q)}</a> <span class="muted">{q.marks} mark{q.marks === 1 ? '' : 's'} · {topicByslug.get(q.topics[0])?.name}</span></li>)}</ul></details></section>
</Base>
