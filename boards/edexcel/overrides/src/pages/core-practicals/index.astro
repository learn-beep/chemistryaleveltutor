---
import Base from '../../layouts/Base.astro';
import { allQuestions, topicByslug } from '../../lib/data';
const prac = allQuestions.filter((q) => (q.features || []).includes('practical') && !q.notCurrentSpec);
const codes = {};
for (const q of prac) for (const s of q.skills || []) { if (!s.code.startsWith('CP')) continue; if (!codes[s.code]) codes[s.code] = { text: s.text, qs: [] }; codes[s.code].qs.push(q); }
const num = (c) => Number(c.slice(2));
const order = Object.keys(codes).sort((a, b) => num(a) - num(b));
const skillsOnly = prac.filter((q) => !(q.skills || []).some((s) => s.code.startsWith('CP')));
// The sixteen core practicals as the specification names them, and what the written papers ask about each, in the site's words. To be checked by a tutor.
const how = {
  CP1: ['Measure the molar volume of a gas', 'Reacting a weighed solid with an acid and collecting the gas in a gas syringe or over water, for example calcium carbonate with ethanoic acid. Papers ask about gas lost before the bung is replaced, the solubility of carbon dioxide in water, plotting volume against mass and using the gradient, and the calculation in dm³ mol⁻¹.'],
  CP2: ['Prepare a standard solution from a solid acid and use it to find the concentration of a solution of sodium hydroxide', 'Weighing by difference, dissolving, transferring with washings and making up to the mark in a volumetric flask, then titrating. Papers ask for the reason for each step, concordant titres and the mean, the calculation, the choice of indicator and percentage uncertainty.'],
  CP3: ['Find the concentration of a solution of hydrochloric acid', 'An acid–base titration with a pipette and burette against a solution of known concentration. Papers ask about rinsing the apparatus, reading the burette, the colour change at the end-point, the calculation and the effect of each error on the titre.'],
  CP4: ['Investigation of the rates of hydrolysis of some halogenoalkanes', 'Warming halogenoalkanes with aqueous silver nitrate in ethanol and timing the appearance of the precipitate. Papers ask why ethanol is used, why a water bath is used, the colours of the precipitates, and how the rate depends on the carbon–halogen bond and on whether the halogenoalkane is primary, secondary or tertiary.'],
  CP5: ['The oxidation of ethanol', 'Oxidising ethanol with acidified dichromate(VI): distilling off the product as it forms, or heating under reflux. Papers ask for labelled diagrams of the apparatus, anti-bumping granules, the direction of water in the condenser, the colour change, and tests on the product.'],
  CP6: ['Chlorination of 2-methylpropan-2-ol using concentrated hydrochloric acid', 'Shaking the alcohol with the acid, then purifying the liquid product: separating funnel, washing with sodium hydrogencarbonate solution, drying with an anhydrous salt and distilling. Papers ask for the reason for each step, which layer is which, and percentage yield.'],
  CP7: ['Analysis of some inorganic and organic unknowns', 'Test-tube and flame tests on the first-year chemistry: Group 1 and 2 ions, carbonate, sulfate, halide and ammonium ions, and alkenes, alcohols and halogenoalkanes. Papers ask for the reagent, the observation and the inference, and for a sequence of tests to identify an unknown.'],
  CP8: ['To determine the enthalpy change of a reaction using Hess’s Law', 'Measuring temperature changes for two reactions in a polystyrene cup and combining them in a Hess cycle. Papers ask for q = mcΔT and the molar enthalpy change, the cycle, heat loss and extrapolating a temperature–time graph, and percentage uncertainty.'],
  CP9: ['Finding the Ka value for a weak acid', 'Following a titration of a weak acid with a strong base with a pH meter. Papers ask about calibrating the meter, the shape of the curve, the equivalence point, and why pH = pKa at half-neutralisation.'],
  CP10: ['Investigating some electrochemical cells', 'Setting up half-cells with a salt bridge and a high-resistance voltmeter. Papers ask what the salt bridge is for and what it contains, the conditions, the cell diagram, calculating E(cell) and why a measured value differs from the standard one.'],
  CP11: ['Redox titration', 'Titrations with potassium manganate(VII), or of iodine with sodium thiosulfate using starch. Papers ask for the colour change at the end-point, why manganate(VII) needs no indicator, when the starch is added, and multi-step calculations such as the percentage of iron in a tablet.'],
  CP12: ['The preparation of a transition metal complex', 'Making and isolating crystals of a complex salt: adding the ligand, crystallising, filtering under reduced pressure, washing and drying. Papers ask for the reason for each step, the equation, the colour changes and the percentage yield.'],
  CP13: ['Rates of reaction: following the rate of the iodine–propanone reaction by a titrimetric method, and investigating a clock reaction', 'Taking samples at timed intervals, quenching them and titrating; and timing a clock reaction at different concentrations. Papers ask why the sample is quenched, how the graph gives the order, the rate equation and the rate constant with its units, and what the orders say about the rate-determining step.'],
  CP14: ['Finding the activation energy of a reaction', 'Timing a reaction at several temperatures and plotting ln(rate) or ln(1/t) against 1/T. Papers ask for the processed data, the graph and its gradient, Ea = –gradient × R with units, and the sources of error.'],
  CP15: ['Analysis of some inorganic and organic unknowns', 'The second-year tests: transition metal ions with sodium hydroxide and ammonia, and carbonyl compounds, carboxylic acids and other organic functional groups (2,4-dinitrophenylhydrazine, Tollens’ reagent, Fehling’s or Benedict’s solution, iodine in alkali). Papers ask for observations, inferences, equations and the identity of the unknown, often with spectra.'],
  CP16: ['The preparation of aspirin', 'Making aspirin from 2-hydroxybenzoic acid and ethanoic anhydride, then recrystallising from the minimum volume of hot solvent and measuring the melting temperature. Papers ask for the reason for each step of recrystallisation, how the melting temperature shows purity, and percentage yield.'],
};
const ref = (q) => `${q.series.replace('June ', 'Jun ').replace('November ', 'Nov ').replace('October ', 'Oct ')} ${q.level === 'AS' ? 'AS ' : ''}${q.paper.replace('Paper ', 'P')} Q${q.question}`;
---
<Base title="Edexcel A-level Chemistry core practicals 1 to 16: every exam question, with mark schemes" description="Every Edexcel Chemistry past-paper question on the sixteen core practicals: molar volume of a gas, titrations, halogenoalkane hydrolysis, oxidation of ethanol, Hess's Law, Ka, electrochemical cells, redox titration, rates, activation energy, unknowns and aspirin, plus the planning, uncertainty and evaluation questions." context="practicals" leadLine="Practical questions are at least 15% of the marks and the easiest to lose. A tutor can take you through each core practical.">
  <h1>Core practicals</h1>
  <p>At least 15% of the marks on the written papers are for practical skills, and Paper 3 includes questions on experimental methods that draw on the core practicals. Edexcel sets sixteen core practicals: 1 to 8 in Topics 1 to 10 (and for AS), 9 to 16 in the second year. Below is what each involves, what the papers ask about it, and every past-paper question tagged to it. There are {prac.length} practical question parts in total; <a href="/questions/type/practical-questions/">see them all with their mark schemes</a>.</p>
  <h2>The sixteen core practicals</h2>
  <div class="table-wrap"><table><thead><tr><th>No.</th><th>Core practical</th><th>What the papers ask</th><th>Questions</th></tr></thead>
  <tbody>{Object.keys(how).map((c) => <tr><td>{codes[c] ? <a href={`#${c}`}>{num(c)}</a> : num(c)}</td><td>{how[c][0]}</td><td>{how[c][1]}</td><td>{codes[c]?.qs.length || 0}</td></tr>)}</tbody></table></div>
  <p class="muted">The names are Edexcel's, from the specification. The descriptions were written by the site from the specification and the mark schemes and are being checked by our tutor. The Practical Endorsement itself is assessed by your teacher and reported separately as a pass.</p>
  {order.map((c) => <section id={c}><h2>Core practical {num(c)}: {how[c] ? how[c][0] : codes[c].text}</h2><p class="muted">{how[c] ? how[c][1] : ''}</p>
    <ul class="qlinks">{codes[c].qs.sort((a, b) => b.year - a.year).map((q) => <li><a href={`/questions/${q.topics[0]}/#${q.id}`}>{ref(q)}</a> <span class="muted">{q.marks} mark{q.marks === 1 ? '' : 's'} · {topicByslug.get(q.topics[0])?.name}</span></li>)}</ul></section>)}
  <section id="skills"><h2>Other practical questions</h2><p class="muted">Questions on apparatus and techniques, experimental design, variables, anomalies, uncertainties and improvements that are not tied to one core practical.</p>
    <details class="spec-fold"><summary>{skillsOnly.length} questions</summary><ul class="qlinks">{skillsOnly.sort((a, b) => b.year - a.year).map((q) => <li><a href={`/questions/${q.topics[0]}/#${q.id}`}>{ref(q)}</a> <span class="muted">{q.marks} mark{q.marks === 1 ? '' : 's'} · {topicByslug.get(q.topics[0])?.name}</span></li>)}</ul></details></section>
</Base>
