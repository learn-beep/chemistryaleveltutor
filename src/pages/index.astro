---
import Base from '../layouts/Base.astro';
import { allTopics, allQuestions, allPapers } from '../lib/data';
import Icon from '../components/Icon.astro';
const order = ['amount-of-substance','organic-basics','alkenes','bonding-and-structure','formulae-and-equations','enthalpy-changes','acids-and-titrations','redox','periodicity','acids-bases-and-buffers','redox-and-electrode-potentials','transition-elements','rate-equations','aromatic-compounds','carboxylic-acids-and-esters','nmr-spectroscopy'];
const top = order.map((s) => allTopics.find((t) => t.slug === s)).filter(Boolean);
const topics = allTopics.map((t) => ({ slug: t.slug, name: t.name, parts: t.parts }));
const current = allQuestions.filter((q) => !q.notCurrentSpec).length;
const latest = allPapers.filter((p) => p.kind === 'exam').map((p) => p.series).sort((a, b) => Number(b.split(' ')[1]) - Number(a.split(' ')[1]))[0];
---
<Base title="OCR A-level Chemistry: past-paper questions by topic, mark schemes and tutors" context="home" leadLine="Not sure where to start? Tell us the year group and target grade and we will arrange a trial session.">
  <h1>OCR A-level Chemistry, one topic at a time</h1>
  <p>{current.toLocaleString()} question parts from {allPapers.length} OCR Chemistry A papers from June 2016 to {latest}, sorted by topic, with the mark scheme and the examiner's comment one tap away. Free, no sign-up.</p>
  <p class="muted">OCR A-level H432 and AS H032 (Chemistry A). Modules 1 to 4 are the AS content; Modules 5 and 6 are A-level only. The June 2026 papers will be added when OCR makes them public.</p>

  <div class="progress-box" id="progress" hidden>
    <strong>Your progress</strong>
    <dl><div><dt>Checklist ticks</dt><dd id="pr-ticks">0</dd></div><div><dt>Questions marked</dt><dd id="pr-q">0</dd></div><div><dt>Weakest topic</dt><dd id="pr-weak">—</dd></div></dl>
    <a href="/planner/">Build a plan from these</a> · <a href="/specification/">Checklist</a>
  </div>

  <nav class="tool-strip" aria-label="Key tools">
    <a href="/practice/"><Icon name="target" />Practice</a>
    <a href="/past-papers/"><Icon name="file" />Past papers</a>
    <a href="/mechanisms/"><Icon name="pen" />Mechanisms</a>
    <a href="/maths-skills/"><Icon name="calculator" />Calculations</a>
    <a href="/practicals/"><Icon name="checklist" />Practicals</a>
  </nav>

  <label for="topic-search" class="muted">Find a topic</label>
  <input id="topic-search" class="search" type="search" placeholder="e.g. moles, buffers, benzene, NMR" autocomplete="off" />

  <h2 class="strand-head">Most-examined topics</h2>
  <ul class="topic-list" id="topic-list">
    {top.map((t) => <li><a href={`/questions/${t.slug}/`}><span>{t.name}</span><span class="strand"><span class={`badge badge-${t.paper.replace('Module ', '')}`}>{t.paper.replace('Module ', 'M')}</span> {t.parts} parts</span></a></li>)}
  </ul>
  <p><a href="/questions/">All {allTopics.length} topics by module</a></p>

  <h2>Everything on the site</h2>
  <div class="tiles">
    <a class="tile-card" href="/past-papers/"><Icon name="file" /><strong>Past papers</strong><span>Every H432 and H032 paper since 2016 with a question-by-question table, mark schemes and examiners' comments</span></a>
    <a class="tile-card" href="/practice/"><Icon name="target" /><strong>Practice</strong><span>Real questions one at a time; instant marking on multiple choice, self-marking on the rest</span></a>
    <a class="tile-card" href="/maths-skills/"><Icon name="calculator" /><strong>Calculations</strong><span>Every calculation question, sorted by the maths skills in the specification</span></a>
    <a class="tile-card" href="/mechanisms/"><Icon name="pen" /><strong>Mechanisms</strong><span>Every curly-arrow question with the mark scheme's mechanism, and what each arrow must show</span></a>
    <a class="tile-card" href="/practicals/"><Icon name="checklist" /><strong>Practicals</strong><span>Practical questions by PAG: titrations, enthalpy, rates, tests for ions, organic synthesis</span></a>
    <a class="tile-card" href="/six-mark-questions/"><Icon name="layers" /><strong>Six-mark questions</strong><span>Every level of response question set, by topic, with a timed practice tool</span></a>
    <a class="tile-card" href="/data-sheet/"><Icon name="book" /><strong>Data Sheet</strong><span>What OCR gives you in the exam, and the equations you have to learn</span></a>
    <a class="tile-card" href="/mock/"><Icon name="timer" /><strong>Mini-mock builder</strong><span>A paper-shaped timed mock from real questions: Paper 1, 2 or 3</span></a>
    <a class="tile-card" href="/specification/"><Icon name="checklist" /><strong>Spec checklist</strong><span>Every learning outcome of the specification, tickable, linked to its questions</span></a>
    <a class="tile-card" href="/analysis/"><Icon name="chart" /><strong>What comes up</strong><span>Marks by topic since 2017, the latest papers, every paper as a timeline</span></a>
    <a class="tile-card" href="/grade-boundaries/"><Icon name="calendar" /><strong>Boundaries and dates</strong><span>Grade calculator and the 2027 exam dates with a countdown</span></a>
    <a class="tile-card" href="/tutors/"><Icon name="users" /><strong>Your tutor</strong><span>Online one-to-one lessons with a specialist OCR chemistry tutor</span></a>
  </div>

  <script define:vars={{ topics }}>
    try {
      const ticks = JSON.parse(localStorage.getItem('malt-spec') || '{}'), scores = JSON.parse(localStorage.getItem('malt-scores') || '{}');
      const nTicks = Object.values(ticks).filter(Boolean).length, rows = Object.entries(scores);
      const nQ = rows.reduce((n, [, r]) => n + (r.n || 0), 0);
      if (nTicks || nQ) {
        document.getElementById('progress').hidden = false;
        document.getElementById('pr-ticks').textContent = nTicks;
        document.getElementById('pr-q').textContent = nQ;
        const weak = rows.filter(([, r]) => r.total).sort((a, b) => a[1].earned / a[1].total - b[1].earned / b[1].total)[0];
        if (weak) { const t = topics.find((x) => x.slug === weak[0]); document.getElementById('pr-weak').innerHTML = t ? `<a href="/questions/${t.slug}/">${t.name.split(':')[0]}</a> ${Math.round(100 * weak[1].earned / weak[1].total)}%` : '—'; }
      }
    } catch {}
    const input = document.getElementById('topic-search');
    const list = document.getElementById('topic-list');
    const initial = list.innerHTML;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = initial; return; }
      const items = topics.filter((t) => t.name.toLowerCase().includes(q) || t.slug.includes(q.replace(/\s+/g, '-')));
      list.innerHTML = items.length
        ? items.map((t) => `<li><a href="/questions/${t.slug}/"><span>${t.name}</span><span class="strand">${t.parts} parts</span></a></li>`).join('')
        : '<li class="muted">No topic matches that. <a href="/questions/">Browse all topics</a>.</li>';
    });
  </script>
</Base>
