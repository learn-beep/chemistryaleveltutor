---
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import Motif from '../../components/Motif.astro';
import Icon from '../../components/Icon.astro';
import Hint from '../../components/Hint.astro';
import { allTopics, questionsForTopic } from '../../lib/data';
import { deckFor } from '../../lib/decks';
export function getStaticPaths() {
  return allTopics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const qs = questionsForTopic(topic.slug);
const current = qs.filter((q) => !q.notCurrentSpec);
const essays = current.filter((q) => q.format === 'Level of response');
const calcs = current.filter((q) => q.format === 'Calculation');
const years = [...new Set(qs.map((q) => q.year))].sort((a, b) => b - a);
const papers = [...new Set(qs.map((q) => q.paper))].sort();
const deck = deckFor(topic.slug);
const mod = Number(topic.paper.replace('Module ', ''));
const motifKind = mod === 1 ? 'flask' : mod === 2 ? (topic.slug.includes('electron') || topic.slug.includes('atomic') || topic.slug.includes('bonding') ? 'orbital' : 'flask') : mod === 3 ? (topic.slug.includes('enthalpy') || topic.slug.includes('rates') || topic.slug.includes('equilibrium') ? 'energy' : 'orbital') : mod === 4 ? (topic.slug.includes('infrared') ? 'spectrum' : 'chain') : mod === 5 ? (topic.slug.includes('transition') ? 'orbital' : 'energy') : (topic.slug.includes('nmr') || topic.slug.includes('chromatography') ? 'spectrum' : topic.slug.includes('aromatic') ? 'benzene' : 'chain');
const whichPaper = { 1: 'all three papers', 2: 'all three papers', 3: 'Paper 1 and Paper 3', 4: 'Paper 2 and Paper 3', 5: 'Paper 1 and Paper 3', 6: 'Paper 2 and Paper 3' }[mod];
const asPaper = mod <= 4 ? 'AS Papers 1 and 2' : null;
---
<Base title={`${topic.name}: OCR A-level Chemistry past-paper questions with mark schemes`} description={`Every OCR Chemistry A past-paper question on ${topic.name.toLowerCase()} since 2016 (${current.length} parts), with mark schemes and examiners' comments, filtered by question type.`} context={`topic:${topic.slug}`}>
  <div class="topic-head"><h1>{topic.name} <span class={`badge badge-${mod}`}>{topic.paper}</span></h1><Motif kind={motifKind} /></div>
  <div class="where">
    <dl>
      <dt>Where it is examined</dt><dd>A-level {whichPaper}{asPaper ? `; ${asPaper}` : ''}</dd>
      <dt>Level</dt><dd>{topic.asOrA}</dd>
      <dt>Specification</dt><dd>Section {topic.code}, {topic.statements.length} learning outcome{topic.statements.length === 1 ? '' : 's'}</dd>
      <dt>Since 2016</dt><dd>{current.length} question parts: {topic.mcq} multiple choice, {calcs.length} calculations, {essays.length} six-mark level of response</dd>
    </dl>
  </div>
  <div class="score-note" id="myscore" hidden></div>

  {deck ? <div class="btn-row"><a class="btn btn-accent" href={`/questions/${topic.slug}/terms/`}><Icon name="layers" />Key terms cards ({deck.terms.length})</a><a class="btn" href="/practice/define/"><Icon name="target" />Define-it drill</a></div> : <p class="muted">Notes and key-term cards for this topic are being written by our tutors. The past-paper questions below are ready now.</p>}

  <h2>Learning outcomes</h2>
  <details class="spec-fold"><summary>Show the {topic.statements.length} learning outcomes from the specification</summary><ul class="spec-list">{topic.statements.map((id) => <li><strong>{id}</strong> {topic.statementText[id]}</li>)}</ul></details>

  {essays.length > 0 && <><h2>Six-mark level of response questions on this topic</h2>
  <div class="table-wrap"><table><thead><tr><th>Series</th><th>Paper</th><th>Q</th><th>What it asks</th></tr></thead>
  <tbody>{essays.map((q) => <tr><td>{q.series}</td><td>{q.level === 'AS' ? 'AS ' : ''}{q.paper}</td><td><a href={`#${q.id}`}>{q.question}</a></td><td>{(q.text.split('\n').filter((l) => /^\(?[a-z]\)?\*|\*/.test(l) || /\b(Explain|Describe|Determine|Plan|Suggest|Use|Analyse|Compare|Outline|Deduce|Identify|Calculate)\b/.test(l)).slice(0, 2).join(' ') || q.text.split('\n')[0]).replace(/^\(?[a-z0-9]+\)?\*?\s*/i, '').slice(0, 220)}</td></tr>)}</tbody></table></div></>}

  <h2>Past-paper questions</h2>
  <p><a class="btn" href={`/questions/${topic.slug}/print/`}><Icon name="printer" />Print this topic as a pack</a></p>
  <div class="filterbar"><div class="chips" role="group" aria-label="Filter">
    <button class="chip" type="button" aria-pressed="true" data-filter="">All ({current.length})</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Multiple choice">Multiple choice</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Calculation">Calculations</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Equation writing">Equations</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Mechanism">Mechanisms</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Structure / isomer">Structures</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="format:Level of response">Six-markers</button>
    {papers.map((p) => <button class="chip" type="button" aria-pressed="false" data-filter={`paper:${p}`}>{p}</button>)}
    <button class="chip" type="button" aria-pressed="false" data-filter="level:AS">AS</button>
    <button class="chip" type="button" aria-pressed="false" data-filter="level:A level">A level</button>
    {years.slice(0, 3).map((y) => <button class="chip" type="button" aria-pressed="false" data-filter={`year:${y}`}>{y}</button>)}
  </div><div class="count" id="count"></div></div>
  <Hint id="reveal" text="Tap a question to zoom it. Where a part needs a table, graph or structure from an earlier part, that part folds out above it; the mark scheme and examiner's comment open underneath. Have the OCR Data Sheet beside you." />
  {qs.map((q) => <QuestionCard q={q} />)}

  <script define:vars={{ slug: topic.slug }}>
    try { const s = JSON.parse(localStorage.getItem('malt-scores') || '{}')[slug]; if (s && s.total) { const el = document.getElementById('myscore'); el.hidden = false; el.innerHTML = `Your practice score on this topic: <strong>${s.earned}/${s.total}</strong> (${Math.round(100 * s.earned / s.total)}%) over ${s.n} question${s.n === 1 ? '' : 's'}. <a href="/practice/">Practise more</a>`; } } catch {}
  </script>
  <script>
    const chips = document.querySelectorAll('.chip[data-filter]');
    const cards = document.querySelectorAll('.qcard');
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      c.setAttribute('aria-pressed', 'true');
      const f = c.getAttribute('data-filter') || '';
      const [key, val] = f.split(':');
      cards.forEach((card) => { card.hidden = !!f && card.getAttribute('data-' + key) !== val; });
      document.getElementById('count').textContent = `Showing ${[...cards].filter((c) => !c.hidden).length} of ${cards.length}`;
    }));
  </script>
</Base>
