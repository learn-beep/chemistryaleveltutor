---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { allQuestions, allTopics } from '../../lib/data';
const lor = allQuestions.filter((q) => q.format === 'Level of response' && !q.notCurrentSpec).sort((a, b) => b.year - a.year);
const title = (q) => { const lines = q.text.split('\n').map((l) => l.trim()).filter((l) => l && !/^\.{3,}|^Extra answer space|^Additional answer space|^\[\d+\]$|^\d+$|^SECTION|^Answer all|^©|^Turn over/i.test(l)); const i = lines.findIndex((l) => /\*/.test(l)); const pick = (i >= 0 ? lines.slice(i, i + 3) : lines.slice(-3)).join(' '); return pick.replace(/^\d*\s*\(?[a-z]?\)?\s*(\([ivx]+\))?\*?\s*/i, '').replace(/\s*\[\d+\]\s*$/, '').replace(/\.{4,}.*/, '').slice(0, 230); };
const byTopic = allTopics.map((t) => [t, lor.filter((q) => q.topics.includes(t.slug))]).filter(([, qs]) => qs.length);
---
<Base title="Every OCR A-level Chemistry six-mark level of response question, by topic, with a timed tool" description="All the six-mark level of response questions (the ones marked with an asterisk) set on OCR Chemistry A since 2016, grouped by topic, with a timed practice tool that reveals the mark scheme's levels and indicative points." context="six-mark-questions" leadLine="Stuck at Level 2 on the six-markers? Message us.">
  <h1>Six-mark level of response questions</h1>
  <p>{lor.length} level of response questions, the ones marked with an asterisk (*), grouped by topic. Each A-level paper has two of them; each AS paper has one or two. Pick one to answer under timed conditions (about eight minutes), then open the mark scheme with its three levels and indicative points and decide your level.</p>
  <h2>How they are marked</h2>
  <div class="table-wrap"><table><thead><tr><th>Level</th><th>Marks</th><th>What it takes</th></tr></thead><tbody>
    <tr><td>Level 3</td><td>5–6</td><td>All the strands of the question are answered with correct chemistry, in a clear and logical line of reasoning, with the evidence or working to support it.</td></tr>
    <tr><td>Level 2</td><td>3–4</td><td>Most of the chemistry is right but one strand is missing or wrong, or the reasoning has some structure but gaps.</td></tr>
    <tr><td>Level 1</td><td>1–2</td><td>Some correct points, but one strand only or an answer without a clear structure.</td></tr>
  </tbody></table></div>
  <p class="muted">The examiner first decides the level from the chemistry, then picks the higher or lower mark in that level from how well the answer is communicated. Most questions have two or three strands (for example: do the calculation, identify the compound, explain the evidence): attempt every strand. Summary written by the site from OCR's marking instructions; being checked by our tutor.</p>
  <h2>Timed practice</h2>
  <div class="panel">
    <div class="chips" id="topic-chips">{byTopic.map(([t]) => <button class="chip" type="button" data-topic={t.slug} aria-pressed="false">{t.name.split(':')[0]}</button>)}</div>
    <div class="chips" data-group="level"><button class="chip" type="button" data-v="" aria-pressed="true">Either</button><button class="chip" type="button" data-v="A level">A level</button><button class="chip" type="button" data-v="AS">AS</button></div>
    <div><button class="btn btn-accent" type="button" id="draw">Give me a question</button> <span class="muted">(random from the selected topics, or from all)</span></div>
  </div>
  <div id="play" hidden>
    <div class="playbar"><span id="which"></span><span class="timer" id="timer">8:00</span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start the clock</button></div>
    <div id="card"></div>
  </div>
  <h2>All the questions by topic</h2>
  {byTopic.map(([t, qs]) => <><h3><a href={`/questions/${t.slug}/`}>{t.name}</a> <span class="muted">({qs.length})</span></h3>
    <div class="table-wrap"><table><thead><tr><th>Series</th><th>Paper</th><th>What it asks</th></tr></thead>
    <tbody>{qs.map((q) => <tr><td>{q.series}</td><td>{q.level === 'AS' ? 'AS ' : ''}{q.paper} Q{q.question}</td><td><a href={`/questions/${t.slug}/#${q.id}`}>{title(q)}</a></td></tr>)}</tbody></table></div></>)}
  <script>
    import { loadBank, card, saveScore, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = new Set(); let level = '', bank = null, timer = null, secs = 480, current = null;
    document.querySelectorAll('[data-topic]').forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); on ? sel.add(b.dataset.topic) : sel.delete(b.dataset.topic); }));
    document.querySelectorAll('[data-group="level"] .chip').forEach((b) => b.addEventListener('click', () => { document.querySelectorAll('[data-group="level"] .chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); level = b.dataset.v; }));
    loadBank().then((b) => { bank = b; });
    $('#draw').addEventListener('click', () => {
      if (!bank) return;
      const pool = bank.q.filter((q) => q.f === 'Level of response' && !q.old && q.c && (!level || q.l === level) && (!sel.size || q.t.some((t) => sel.has(t))));
      if (!pool.length) return;
      current = shuffle(pool)[0];
      secs = Math.round(current.m * 80);
      $('#play').hidden = false; $('#which').textContent = `${current.s} ${current.l === 'AS' ? 'AS ' : ''}${current.p} Q${current.q} (${current.m} marks)`; $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      const holder = $('#card'); holder.innerHTML = ''; holder.appendChild(card(current, { mark: true, onMark: (m) => saveScore(current.t, m, current.m, current.id) }));
      window.scrollTo({ top: $('#play').offsetTop - 80, behavior: 'smooth' });
    });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
  </script>
</Base>
