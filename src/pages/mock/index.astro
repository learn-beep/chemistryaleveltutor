---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="OCR A-level Chemistry mini-mock builder: timed papers from real questions" description="Build a timed mini-mock from real OCR Chemistry A past-paper questions in the shape of Paper 1, 2 or 3 (or the AS papers): the multiple-choice section, whole structured questions, or a full paper. Play it on screen or print it with the mark schemes." context="mock" leadLine="Want a mock marked properly and gone through? Message us.">
  <h1>Mini-mock builder</h1>
  <p>Assembles a paper from real OCR questions in the shape of the exam. A-level Papers 1 and 2 are fifteen multiple-choice questions (Section A) and 85 marks of structured questions (Section B), in 2 hours 15 minutes. Paper 3 is 70 marks of structured questions on any part of the course, in 1 hour 30 minutes. AS Paper 1 is twenty multiple-choice questions and 50 marks of structured questions; AS Paper 2 is 70 marks of structured questions. Structured questions are kept whole, so every part has the information it needs. Have the Data Sheet beside you.</p>
  <div class="panel" id="setup">
    <h3>Paper</h3>
    <div class="chips" data-group="paper"><button class="chip" type="button" data-v="Paper 1" aria-pressed="true">Paper 1 (periodic table, elements and physical)</button><button class="chip" type="button" data-v="Paper 2">Paper 2 (synthesis and analytical techniques)</button><button class="chip" type="button" data-v="Paper 3">Paper 3 (unified chemistry)</button></div>
    <h3>Level</h3>
    <div class="chips" data-group="level"><button class="chip" type="button" data-v="A level" aria-pressed="true">A level</button><button class="chip" type="button" data-v="AS">AS</button></div>
    <h3>Length</h3>
    <div class="chips" data-group="part"><button class="chip" type="button" data-v="A" aria-pressed="true">Multiple choice only</button><button class="chip" type="button" data-v="B">Structured questions, about 40 marks</button><button class="chip" type="button" data-v="full">Full paper</button></div>
    <p class="muted" id="shape"></p>
    <div><button class="btn btn-accent" type="button" id="build">Build my mock</button></div>
  </div>
  <div id="paper" hidden>
    <div class="playbar"><span id="title"></span><span class="timer" id="timer"></span><span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start timer</button> <button class="btn" type="button" id="print"><Icon name="printer" />Print</button> <button class="btn" type="button" id="share"><Icon name="link" />Copy link</button></span></div>
    <div id="cards"></div>
    <div class="btn-row"><button class="btn btn-accent" type="button" id="rebuild">Build another</button></div>
  </div>
  <script>
    import { loadBank, card, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = { paper: 'Paper 1', level: 'A level', part: 'A' };
    let bank = null, timer = null, secs = 0;
    // [multiple-choice questions, structured marks, seconds per mark] for each paper
    const SHAPE = { 'A level': { 'Paper 1': [15, 85, 81], 'Paper 2': [15, 85, 81], 'Paper 3': [0, 70, 77] }, AS: { 'Paper 1': [20, 50, 77], 'Paper 2': [0, 70, 77] } };
    const shapeOf = () => SHAPE[sel.level][sel.paper];
    function shape() {
      const sh = shapeOf();
      if (!sh) { $('#shape').textContent = 'There is no AS Paper 3; the AS papers are Paper 1 (Breadth in chemistry) and Paper 2 (Depth in chemistry).'; return; }
      const [mc, st] = sh;
      const t = { A: mc ? `${mc} multiple-choice questions, marked instantly (${mc} marks, about ${Math.round(mc * sh[2] / 60)} minutes).` : `${sel.level === 'AS' ? 'AS ' : ''}${sel.paper} has no multiple-choice section; choose structured questions or the full paper.`,
        B: `Whole structured questions adding up to about ${Math.min(40, st)} marks (about ${Math.round(Math.min(40, st) * sh[2] / 60)} minutes).`,
        full: `${mc ? `${mc} multiple-choice questions and ` : ''}${st} marks of structured questions (${mc + st} marks, ${mc + st === 100 ? '2 hours 15 minutes' : '1 hour 30 minutes'}).` };
      $('#shape').textContent = t[sel.part];
    }
    document.querySelectorAll('[data-group]').forEach((g) => g.querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => { g.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); sel[g.dataset.group] = b.dataset.v; shape(); })));
    shape();
    loadBank().then((b) => { bank = b; });
    const groupsOf = (qs) => { const m = new Map(); for (const q of qs) { if (!m.has(q.g)) m.set(q.g, []); m.get(q.g).push(q); } return [...m.values()]; };
    const marksOf = (g) => g.reduce((a, q) => a + q.m, 0);
    function fill(groups, target) {
      // whole questions up to the target: take any that fit, then top up with the closest fit
      const out = []; let total = 0;
      for (const g of groups) { const m = marksOf(g); if (total + m <= target + 2) { out.push(g); total += m; } if (total >= target - 2) break; }
      return out;
    }
    $('#build').addEventListener('click', () => {
      if (!bank) return;
      const sh = shapeOf(); if (!sh) return;
      const [mc, st] = sh;
      const pool = bank.q.filter((q) => !q.old && q.c && q.l === sel.level && q.p === sel.paper);
      const mcqs = shuffle(pool.filter((q) => q.f === 'Multiple choice' && q.ans));
      const groups = shuffle(groupsOf(pool.filter((q) => q.f !== 'Multiple choice')));
      let picked = [];
      const add = (g) => { picked = picked.concat(g.slice().sort((a, b) => a.q.localeCompare(b.q, undefined, { numeric: true }))); };
      if (sel.part === 'A') { if (!mc) { shape(); return; } picked = mcqs.slice(0, mc); }
      else if (sel.part === 'B') fill(groups, Math.min(40, st)).forEach(add);
      else { picked = mcqs.slice(0, mc); fill(groups, st).forEach(add); }
      if (!picked.length) { $('#shape').textContent = 'Nothing matched; try another combination.'; return; }
      const total = picked.reduce((a, q) => a + q.m, 0);
      $('#setup').hidden = true; $('#paper').hidden = false;
      $('#title').textContent = `${sel.level} ${sel.paper}: ${picked.length} parts, ${total} marks`;
      secs = Math.round(total * sh[2]); $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      renderPicked(picked);
      location.hash = 'set=' + picked.map((q) => q.id).join(',');
      window.scrollTo({ top: 0 });
    });
    function renderPicked(picked) { const holder = $('#cards'); holder.innerHTML = ''; let lastG = null; picked.forEach((q, n) => { const c = card(q, { mcq: true }); c.querySelector('.meta strong').textContent = `Part ${n + 1} (from ${q.s} ${q.l === 'AS' ? 'AS ' : ''}${q.p} Q${q.q})`; if (q.g === lastG) { const st = c.querySelector('details.stem'); if (st) st.remove(); } lastG = q.g; holder.appendChild(c); }); }
    $('#share').addEventListener('click', async () => { const url = location.href.split('#')[0] + location.hash; try { await navigator.clipboard.writeText(url); window.maltToast && window.maltToast('Link copied'); } catch { prompt('Copy this link', url); } });
    loadBank().then(() => { const m = location.hash.match(/set=([^&]+)/); if (!m || !bank) return; const ids = decodeURIComponent(m[1]).split(','); const picked = ids.map((id) => bank.q.find((q) => q.id === id)).filter(Boolean); if (!picked.length) return; const total = picked.reduce((a, q) => a + q.m, 0); $('#setup').hidden = true; $('#paper').hidden = false; $('#title').textContent = `Shared mock: ${picked.length} parts, ${total} marks`; secs = Math.round(total * 80); $('#timer').textContent = fmtTime(secs); renderPicked(picked); });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
    $('#print').addEventListener('click', () => { document.querySelectorAll('#cards img[data-src]').forEach((img) => { img.src = img.dataset.src; img.removeAttribute('data-src'); }); document.querySelectorAll('#cards details.stem').forEach((d) => { d.open = true; }); setTimeout(() => window.print(), 300); });
    $('#rebuild').addEventListener('click', () => { if (timer) clearInterval(timer); $('#paper').hidden = true; $('#setup').hidden = false; window.scrollTo({ top: 0 }); });
  </script>
</Base>
