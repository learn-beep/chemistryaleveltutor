---
import site from '../data/site.json';
import Icon from './Icon.astro';
import Search from './Search.astro';
// The first label is written as 'OC' + 'R' so that the other boards' blanket OCR -> AQA / Edexcel replacement leaves it alone.
const other = site.board === 'aqa' || site.board === 'edexcel';
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={other ? `/${site.board}/` : '/'}><span>{site.name}</span></a>
    <span class="board-switch" aria-label="Exam board"><a href="/" aria-current={!other ? 'page' : undefined}>{'OC' + 'R'}</a><a href="/aqa/" aria-current={site.board === 'aqa' ? 'page' : undefined}>AQA</a><a href="/edexcel/" aria-current={site.board === 'edexcel' ? 'page' : undefined}>Edexcel</a></span>
    <nav class="site-nav" aria-label="Main">
      <a href="/questions/"><Icon name="book" />Questions</a>
      <a href="/past-papers/"><Icon name="file" />Past papers</a>
      <a href="/practice/"><Icon name="target" />Practice</a>
      <a href="/mechanisms/"><Icon name="pen" />Mechanisms</a>
      <a href="/maths-skills/"><Icon name="calculator" />Calculations</a>
      <a href="/tutors/"><Icon name="users" />Tutor</a>
    </nav>
    <button class="search-toggle" type="button" id="search-toggle" aria-expanded="false" aria-controls="search-panel"><Icon name="target" />Search</button>
  </div>
  <Search />
</header>
